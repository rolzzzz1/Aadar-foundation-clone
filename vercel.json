{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "framework": "create-react-app",
  "functions": {
    "api/razorpay-webhook.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "server/_lib/fonts/**"
    },
    "api/[...path].js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "server/_lib/fonts/**"
    }
  },
  "crons": [
    { "path": "/api/razorpay-qr-sync", "schedule": "5 0 * * *" },
    { "path": "/api/razorpay-qr-sync", "schedule": "5 2 * * *" },
    { "path": "/api/razorpay-qr-sync", "schedule": "5 4 * * *" },
    { "path": "/api/razorpay-qr-sync", "schedule": "5 6 * * *" },
    { "path": "/api/razorpay-qr-sync", "schedule": "5 8 * * *" },
    { "path": "/api/razorpay-qr-sync", "schedule": "5 10 * * *" },
    { "path": "/api/razorpay-qr-sync", "schedule": "5 12 * * *" },
    { "path": "/api/razorpay-qr-sync", "schedule": "5 14 * * *" },
    { "path": "/api/razorpay-qr-sync", "schedule": "5 16 * * *" },
    { "path": "/api/razorpay-qr-sync", "schedule": "5 18 * * *" },
    { "path": "/api/razorpay-qr-sync", "schedule": "5 20 * * *" },
    { "path": "/api/razorpay-qr-sync", "schedule": "5 22 * * *" }
  ],
  "redirects": [
    { "source": "/pages/landing-pages/about-us", "destination": "/about", "permanent": true },
    { "source": "/pages/landing-pages/about", "destination": "/about", "permanent": true },
    { "source": "/pages/landing-pages/work", "destination": "/work", "permanent": true },
    { "source": "/pages/landing-pages/volunteer", "destination": "/volunteer", "permanent": true },
    { "source": "/pages/landing-pages/donate", "destination": "/donate", "permanent": true },
    { "source": "/pages/landing-pages/donate2", "destination": "/donate2", "permanent": false },
    { "source": "/pages/landing-pages/gallery", "destination": "/gallery", "permanent": true },
    { "source": "/pages/landing-pages/contact", "destination": "/contact", "permanent": true },
    { "source": "/pages/landing-pages/privacy-policy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/pages/landing-pages/terms-conditions", "destination": "/terms-and-conditions", "permanent": true },
    { "source": "/__razorpay-test", "destination": "/donate/checkout", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|static/|assets/|locales/|favicon\\.ico|manifest\\.json|robots\\.txt|sitemap\\.xml|apple-icon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/locales/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

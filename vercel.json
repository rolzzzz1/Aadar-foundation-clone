{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "framework": "create-react-app",
  "redirects": [
    { "source": "/pages/landing-pages/about-us", "destination": "/about", "permanent": true },
    { "source": "/pages/landing-pages/about", "destination": "/about", "permanent": true },
    { "source": "/pages/landing-pages/work", "destination": "/work", "permanent": true },
    { "source": "/pages/landing-pages/volunteer", "destination": "/volunteer", "permanent": true },
    { "source": "/pages/landing-pages/donate", "destination": "/donate", "permanent": true },
    { "source": "/pages/landing-pages/donate2", "destination": "/donate", "permanent": false },
    { "source": "/pages/landing-pages/gallery", "destination": "/gallery", "permanent": true },
    { "source": "/pages/landing-pages/contact", "destination": "/contact", "permanent": true },
    { "source": "/pages/landing-pages/privacy-policy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/pages/landing-pages/terms-conditions", "destination": "/terms-and-conditions", "permanent": true },
    { "source": "/__razorpay-test", "destination": "/donate/checkout", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|static/|assets/|locales/|favicon\\.ico|manifest\\.json|robots\\.txt|sitemap\\.xml|apple-icon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/locales/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}

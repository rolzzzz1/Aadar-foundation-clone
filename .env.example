# Copy this file to `.env.local` (recommended) or `.env` and fill in your Razorpay TEST keys
# Dashboard: https://dashboard.razorpay.com/app/keys
#
# After editing, restart: npm start

# --- Payments feature flag ---
# Local npm start: payments ON by default (no need to set these).
# Vercel Production: leave UNSET or set to false until you go live.
# Vercel Preview (optional remote testing): set both to true + use test keys below.
# REACT_APP_PAYMENTS_ENABLED=true
# PAYMENTS_ENABLED=true

# Public key (used by the React checkout UI)
REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Server keys (used by /api/razorpay-order and /api/razorpay-verify)
# Key ID is usually the same as REACT_APP_RAZORPAY_KEY_ID
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Local dev only — if API calls fail with SSL/certificate errors (Razorpay, Instagram, VPN/antivirus):
# RAZORPAY_INSECURE_TLS=true

# Webhook (Razorpay Dashboard → Settings → Webhooks → Add New Webhook)
# URL: https://www.aadarfoundation.org/api/razorpay-webhook
# Events: payment.captured (required)
# Recurring memberships (Razorpay Subscriptions) also need these events on the SAME webhook:
#   subscription.charged, subscription.activated, subscription.completed, subscription.cancelled,
#   subscription.halted, subscription.paused, subscription.resumed, subscription.pending
# After saving, copy the Webhook Secret below:
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: permanent donation log (Supabase). See supabase/donations.sql
# Recurring memberships additionally require supabase/membership.sql (membership_plans +
# membership_subscriptions tables, plus subscription_id/is_recurring/frequency columns on
# donations). Without Supabase configured, subscriptions still work on Razorpay, but plan IDs
# are re-created per request and subscription lifecycle state is not tracked locally.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Donation receipt email (Resend — https://resend.com)
# Verify your sending domain in Resend, then set:
# RESEND_API_KEY=re_xxxxxxxx
# RECEIPT_FROM_EMAIL=Aadar Foundation <receipts@yourdomain.com>
# RECEIPT_REPLY_TO=aadarfoundation2018@gmail.com
# ^ Send from info@ (Resend) but replies go to your monitored inbox
# RECEIPT_SITE_URL=https://www.aadarfoundation.org
# Optional: where Direct QR/bank receipt-request form emails are delivered
# RECEIPT_REQUEST_TO_EMAIL=aadarfoundation2018@gmail.com
# Optional: force resend receipt emails in production (POST /api/donation-receipt-resend)
# RECEIPT_RESEND_SECRET=your-long-random-secret
# Admin page (/admin/receipt) — issue UPI/bank transfer receipts (POST /api/admin-donation-receipt)
# ADMIN_RECEIPT_SECRET=your-long-random-admin-password
# ADMIN_RECEIPT_USERNAME=admin
# Optional: local PDF rendering if Chrome is not in default path (Windows example)
# CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Receipt recovery (optional): POST /api/donation-receipt with payment_id + donor_email + donor_pan
# Requires Supabase vars above. See docs/PAYMENTS_VERCEL_SETUP.md

# Origins allowed to POST /api/razorpay-order and /api/razorpay-verify (comma-separated, no trailing slash).
# Required on Vercel Production. Preview deploys also allow https://<VERCEL_URL> automatically.
# Local dev: leave unset, or include http://localhost:3000
ALLOWED_ORIGINS=https://www.aadarfoundation.org,https://aadarfoundation.org

# Instagram (Home page posts carousel) — server-only, used by GET /api/instagram-posts
# Meta Developer → your app → Instagram Graph API. Copy from Vercel if already configured.
# INSTAGRAM_ACCESS_TOKEN=your_long_lived_token
# INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

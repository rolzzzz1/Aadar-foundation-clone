# Copy this file to `.env.local` (recommended) or `.env` and fill in your Razorpay TEST keys
# Dashboard: https://dashboard.razorpay.com/app/keys
#
# After editing, restart: npm start

# Public key (used by the React checkout UI)
REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Server keys (used by /api/razorpay-order and /api/razorpay-verify)
# Key ID is usually the same as REACT_APP_RAZORPAY_KEY_ID
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here
